{
  "name": "data-ingestion-service",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun --bun run tsc && bun scripts/copy-evidence-skills.mjs && bun scripts/stamp-evidence-dependencies.mjs",
    "watch": "bun --bun run tsc -w",
    "clean": "bun --bun run rimraf dist",
    "lint": "bun --bun run eslint . --max-warnings 0",
    "test": "bun run build && bun --bun run vitest run",
    "test:live:evidence": "bun run build && bun scripts/test-evidence-live.mjs",
    "benchmark:evidence-support": "bun run build && bun scripts/test-evidence-support.mjs",
    "benchmark:evidence-specialists": "bun run build && bun scripts/benchmark-evidence-specialists.mjs",
    "benchmark:content-understanding": "bun run build && bun scripts/benchmark-content-understanding.mjs",
    "replay:evidence-canonicalization": "bun run build && bun scripts/replay-evidence-canonicalization.mjs",
    "replay:evidence-classification": "bun run build && bun scripts/replay-evidence-classification.mjs",
    "review:evidence-consistency": "bun run build && bun scripts/review-evidence-consistency.mjs",
    "review:indexed-evidence": "bun run build && bun scripts/review-indexed-evidence.mjs",
    "test:source-search": "bun run build && bun scripts/test-source-partition-search.mjs",
    "benchmark:source-reconciliation": "bun run build && bun scripts/benchmark-source-reconciliation.mjs",
    "evaluate:source-reranking": "bun run build && bun scripts/evaluate-source-reranking.mjs",
    "benchmark:dedup-planning": "bun run build && bun scripts/benchmark-evidence-dedup-planning.mjs",
    "prepare:canonicalization-review": "bun scripts/prepare-canonicalization-review.mjs",
    "summarize:canonicalization-review": "bun scripts/summarize-canonicalization-review.mjs",
    "backfill:evidence-dates": "bun run build && bun scripts/backfill-evidence-dates.mjs",
    "backfill:evidence-search": "bun run build && bun scripts/backfill-evidence-dates.mjs",
    "repair:evidence-locations": "bun run build && bun scripts/repair-evidence-locations.mjs",
    "start": "bun dist/src/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@azure/cosmos": "^4.3.0",
    "@azure/event-hubs": "^6.0.0",
    "@azure/eventhubs-checkpointstore-blob": "^2.0.0",
    "@azure/identity": "^4.8.0",
    "@azure/search-documents": "^12.1.0",
    "@azure/storage-blob": "^12.27.0",
    "@azure/storage-queue": "^12.28.0",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.1.7",
    "@langchain/langgraph": "^1.0.7",
    "@langchain/openai": "^1.2.0",
    "@langchain/textsplitters": "^1.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@toon-format/toon": "4.4.0",
    "applicationinsights": "^3.12.0",
    "compute-cosine-similarity": "^1.1.0",
    "deepagents": "1.14.2",
    "file-type": "^21.3.0",
    "langchain": "^1.0.6",
    "langsmith": "0.9.0",
    "lodash-es": "^4.17.21",
    "mathjs": "^15.2.0",
    "parse5": "^8.0.1",
    "playwright": "1.58.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "semaphore-async-await": "^1.5.1",
    "tiktoken": "^1.0.22",
    "turndown": "^7.2.0",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.16",
    "@types/lodash-es": "^4.17.12",
    "@types/mathjs": "^9.4.1",
    "@types/node": "^20.x",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "rimraf": "^5.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "trustedDependencies": ["esbuild", "protobufjs"],
  "main": "dist/src/index.js"
}
