<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Daat Phoenix</Authors>
    <PackageId>DaatPhoenix.HttpOrchestration</PackageId>
    <Version>1.0.0</Version>
    <Description>Reusable HTTP client for resilient requests and polling asynchronous or Durable Functions operations. Source and maintenance guide: https://github.com/ProBonoLaw/Probono-Law-File-Operations/tree/main/src/HttpOrchestration.</Description>
    <PackageProjectUrl>https://github.com/ProBonoLaw/Probono-Law-File-Operations/tree/main/src/HttpOrchestration</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProBonoLaw/Probono-Law-File-Operations</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>http;async-polling;durable-functions;retry</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
