{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build FileOperations",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/FileOperations/FileOperations.csproj"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build DataIngestionService",
      "type": "process",
      "command": "bun",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/DataIngestionService"
      },
      "problemMatcher": []
    }
  ]
}
