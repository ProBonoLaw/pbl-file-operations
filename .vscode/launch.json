  "compounds": [
    {
      "name": "Azure Test: Ingestion end-to-end",
      "configurations": [
        "File Operations: Gateway (Azure Test)",
        "File Operations: Ingestion (Azure Test)",
        "File Operations: Data Integrity API (Azure Test)",
        "File Operations: Data Ingestion API (Azure Test)",
        "File Operations: Evidence Extraction (Azure Test)"
      ],
      "stopAll": true
    },
    {
      "name": "Azure Test: Deletion end-to-end",
      "configurations": [
        "File Operations: Gateway (Azure Test)",
        "File Operations: Deletion (Azure Test)"
      ],
      "stopAll": true
    }
  ]
}
